{
  "name": "freejobpost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:build": "node scripts/clean-build-output.mjs next",
    "clean:cf": "node scripts/clean-build-output.mjs cloudflare",
    "clean:artifacts": "node scripts/clean-build-output.mjs artifacts",
    "build": "npm run clean:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "node scripts/sanitized-cloudflare-release.mjs build",
    "cf:check": "node scripts/sanitized-cloudflare-release.mjs check",
    "cf:source-check": "node scripts/sanitized-cloudflare-release.mjs source-check",
    "cf:preview": "node scripts/sanitized-cloudflare-release.mjs preview",
    "cf:upload": "node scripts/sanitized-cloudflare-release.mjs upload",
    "cf:stage": "node scripts/sanitized-cloudflare-release.mjs stage",
    "cf:unstage": "node scripts/sanitized-cloudflare-release.mjs unstage",
    "cf:promote": "node scripts/sanitized-cloudflare-release.mjs promote",
    "cf:rollback": "node scripts/sanitized-cloudflare-release.mjs rollback",
    "release:bindings": "node scripts/check-cloudflare-bindings.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "es-module-lexer": "2.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "strip-json-comments": "3.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wrangler": "^4.111.0"
  }
}
